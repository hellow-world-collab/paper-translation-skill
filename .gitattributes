# 统一用 LF 入库，Windows 检出时也不改成 CRLF（脚本里有 shebang，混行尾容易出怪问题）
* text=auto eol=lf

*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.tsv   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# 字体与压缩包按二进制处理
*.ttf   binary
*.woff  binary
*.woff2 binary
*.jpg   binary
*.png   binary
*.pdf   binary
